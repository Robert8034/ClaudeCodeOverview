@page "/"
@using ClaudeCodeOverview.Core.Notifications
@using ClaudeCodeOverview.Core.Queries
@inject IDashboardQueries Queries
@inject IIngestionNotifier Notifier
@implements IDisposable

<PageTitle>ClaudeCodeOverview</PageTitle>

<h1>Claude Code Overview</h1>
<p class="subtitle">
    Costs are <strong>estimated value at API prices</strong> — a Pro subscription is flat-fee.
</p>

@if (_backfill is { } b && b.FilesDone < b.FilesTotal)
{
    <p>Backfilling transcripts… @b.FilesDone / @b.FilesTotal files</p>
}

@if (_stats is null)
{
    <p>Loading…</p>
}
else if (_stats.Turns == 0)
{
    <div class="empty">
        <h2>No usage data yet</h2>
        <p>Point <code>ClaudeOverview:DataRoot</code> at a directory containing Claude Code
           transcripts (<code>~/.claude/projects</code> or its Syncthing mirror) and restart.</p>
    </div>
}
else
{
    <div class="tiles">
        <div class="tile"><span class="label">Input tokens</span><span class="value">@Fmt(_stats.InputTokens)</span></div>
        <div class="tile"><span class="label">Output tokens</span><span class="value">@Fmt(_stats.OutputTokens)</span></div>
        <div class="tile"><span class="label">Cache write</span><span class="value">@Fmt(_stats.CacheCreation)</span></div>
        <div class="tile"><span class="label">Cache read</span><span class="value">@Fmt(_stats.CacheRead)</span></div>
        <div class="tile"><span class="label">Est. value (API prices)</span><span class="value">$@_stats.CostUsd.ToString("N2")</span></div>
        <div class="tile"><span class="label">Net cache savings</span><span class="value">$@_stats.CacheSavingsUsd.ToString("N2")</span></div>
        <div class="tile"><span class="label">Sessions</span><span class="value">@_stats.Sessions</span></div>
        <div class="tile"><span class="label">Turns</span><span class="value">@_stats.Turns</span></div>
        <div class="tile @(_stats.ActiveSessions > 0 ? "active" : "")">
            <span class="label">Active now</span><span class="value">@_stats.ActiveSessions</span>
        </div>
    </div>

    <h2>Per project</h2>
    <table>
        <thead><tr><th>Project</th><th>Tokens</th><th>Est. value</th><th>Sessions</th><th>Last activity</th></tr></thead>
        <tbody>
            @foreach (var p in _projects)
            {
                <tr>
                    <td title="@p.Cwd">@(p.Slug ?? p.Cwd)</td>
                    <td>@Fmt(p.Tokens)</td>
                    <td>$@p.CostUsd.ToString("N2")</td>
                    <td>@p.Sessions</td>
                    <td>@p.LastActivityUtc</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private HeadlineStats? _stats;
    private List<ProjectSummary> _projects = [];
    private BackfillProgress? _backfill;
    private bool _refreshing;

    protected override async Task OnInitializedAsync()
    {
        Notifier.Changed += OnIngestionChanged;
        await RefreshAsync();
    }

    private void OnIngestionChanged(IngestionDelta delta)
    {
        _backfill = delta.Backfill ?? _backfill;
        _ = InvokeAsync(async () =>
        {
            if (_refreshing) return; // latest-wins: the running refresh reads current data anyway
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            var filter = new QueryFilter();
            _stats = await Queries.GetHeadlineStatsAsync(filter);
            _projects = await Queries.GetProjectSummariesAsync(filter);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static string Fmt(long n) => n switch
    {
        >= 1_000_000_000 => (n / 1_000_000_000d).ToString("N1") + "B",
        >= 1_000_000 => (n / 1_000_000d).ToString("N1") + "M",
        >= 1_000 => (n / 1_000d).ToString("N1") + "k",
        _ => n.ToString(),
    };

    public void Dispose() => Notifier.Changed -= OnIngestionChanged;
}
