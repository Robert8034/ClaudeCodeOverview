<MudPaper Elevation="1" Class="pa-3" Style="min-width: 150px">
    <MudText Typo="Typo.overline" Color="Color.Secondary">@Label</MudText>
    <MudText Typo="Typo.h5" Style="font-variant-numeric: tabular-nums">@Value</MudText>
    @if (!string.IsNullOrEmpty(Sub))
    {
        <MudText Typo="Typo.caption" Color="Color.Tertiary">@Sub</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
}
